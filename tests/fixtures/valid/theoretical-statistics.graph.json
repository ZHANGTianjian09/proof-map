  "nodes": [
    {
      "id": "a-independent",
      "type": "assumption",
      "label": "Assumption 1.1",
      "title": "Independent centered observations",
      "statement": "Let $X_1,\\ldots,X_n$ be independent with $\\mathbb{E}X_i=0$.",
      "section": "setup",
      "source": {
        "location": "Synthetic QA note, Assumption 1.1",
        "page": 1
      },
      "number": "1.1",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        },
        "scope": "global_context"
      }
    },
    {
      "id": "a-subgaussian",
      "type": "assumption",
      "label": "Assumption 1.2",
      "title": "Sub-Gaussian moment bound",
      "statement": "For every $t\\in\\mathbb{R}$ and every $i$, $\\mathbb{E}e^{tX_i}\\leq e^{\\sigma^2t^2/2}$, where $\\sigma>0$.",
      "section": "setup",
      "source": {
        "location": "Synthetic QA note, Assumption 1.2",
        "page": 1
      },
      "number": "1.2",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        },
        "scope": "global_context"
      }
    },
    {
      "id": "d-mean",
      "type": "definition",
      "label": "Definition 1.3",
      "title": "Sample mean · 均值",
      "statement": "Define $\\bar X_n=n^{-1}\\sum_{i=1}^n X_i$.",
      "section": "setup",
      "source": {
        "location": "Synthetic QA note, Definition 1.3",
        "page": 1
      },
      "number": "1.3",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        },
        "scope": "local_proof"
      }
    },
    {
      "id": "d-radius",
      "type": "definition",
      "label": "Definition 1.4",
      "title": "Local confidence radius",
      "statement": "For $0<\\delta<1$, let $r_n(\\delta)=\\sigma\\sqrt{2\\log(2/\\delta)/n}$.",
      "section": "setup",
      "source": {
        "location": "Synthetic QA note, Definition 1.4",
        "page": 1
      },
      "number": "1.4",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        },
        "scope": "local_proof"
      }
    },
    {
      "id": "l-mgf",
      "type": "lemma",
      "label": "Lemma 2.1",
      "title": "Moment bound for the mean",
      "statement": "Under Assumptions 1.1–1.2, $\\mathbb{E}e^{t\\bar X_n}\\leq e^{\\sigma^2t^2/(2n)}$ for every real $t$.",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Lemma 2.1",
        "page": 1
      },
      "number": "2.1",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        }
      },
      "evidence": [
        {
          "source": {
            "location": "Synthetic QA note, Lemma 2.1",
            "page": 2
          },
          "excerpt": "Under Assumptions 1.1–1.2, $\\mathbb{E}e^{t\\bar X_n}\\leq e^{\\sigma^2t^2/(2n)}$ for every real $t$.",
          "metadata": {
            "authored": true
          }
        }
      ]
    },
    {
      "id": "l-chernoff",
      "type": "lemma",
      "label": "Lemma 2.2",
      "title": "Exponential Markov bound",
      "statement": "For $t>0$, $\\Pr(Y\\geq u)\\leq e^{-tu}\\mathbb{E}e^{tY}$ whenever the expectation exists.",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Lemma 2.2",
        "page": 1
      },
      "number": "2.2",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        }
      }
    },
    {
      "id": "t-tail",
      "type": "theorem",
      "label": "Theorem 3.1",
      "title": "Concentration of the mean",
      "statement": "Under Assumptions 1.1–1.2, for $u>0$, $$\\Pr(|\\bar X_n|\\geq u)\\leq 2e^{-nu^2/(2\\sigma^2)}.$$",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Theorem 3.1",
        "page": 1
      },
      "number": "3.1",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        }
      },
      "role": "Main result"
    },
    {
      "id": "t-confidence",
      "type": "theorem",
      "label": "Theorem 3.2",
      "title": "Confidence radius",
      "statement": "Under Assumptions 1.1–1.2, $\\Pr(|\\bar X_n|\\geq r_n(\\delta))\\leq\\delta$ for $0<\\delta<1$.",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Theorem 3.2",
        "page": 1
      },
      "number": "3.2",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        }
      },
      "role": "Main result"
    },
    {
      "id": "p-tail",
      "type": "proposition",
      "label": "Proposition 3.3",
      "title": "Equivalent tail formulation",
      "statement": "Under Assumptions 1.1–1.2, $\\Pr(|\\bar X_n|<u)\\geq 1-2e^{-nu^2/(2\\sigma^2)}$ for $u>0$.",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Proposition 3.3",
        "page": 1
      },
      "number": "3.3",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        }
      }
    },
    {
      "id": "c-consistency",
      "type": "corollary",
      "label": "Corollary 3.4",
      "title": "Consistency",
      "statement": "Under Assumptions 1.1–1.2 for all $n$ with fixed $\\sigma$, $\\bar X_n\\to0$ in probability.",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Corollary 3.4",
        "page": 1
      },
      "number": "3.4",
      "metadata": {
        "audit": {
          "tokens": [null, true, 0, "  raw  "],
          "reviewer": null
        }
      }
    },
    {
      "id": "e-normal",
      "type": "example",
      "label": "Example 4.1",
      "title": "Gaussian observations",
      "statement": "Independent $N(0,\\sigma^2)$ observations satisfy Assumptions 1.1–1.2.",
      "section": "results",
      "source": {
        "location": "Synthetic QA note, Example 4.1",
